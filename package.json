{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "dev": "bos dev",
    "dev:ui": "bos dev --ui local --api remote",
    "dev:api": "bos dev --ui remote --api local",
    "dev:proxy": "bos dev --proxy",
    "build": "bos build",
    "deploy": "bos deploy",
    "publish": "bos publish",
    "typecheck": "pnpm run types:gen && if [ -d ui ]; then pnpm --dir ui run typecheck || exit 1; fi && if [ -d api ]; then pnpm --dir api run typecheck || exit 1; fi && for dir in plugins/*; do if [ -f \"$dir/package.json\" ]; then pnpm --dir \"$dir\" run typecheck || exit 1; fi; done",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:shadcn": "pnpm --dir ui lint:shadcn",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bos start",
    "db:push": "pnpm --dir api drizzle-kit push",
    "db:studio": "bos db:studio",
    "db:generate": "pnpm --dir api drizzle-kit generate",
    "db:migrate": "pnpm --dir api drizzle-kit migrate",
    "db:migrate:contributors": "tsx scripts/migrate-contributors-to-builders.ts",
    "db:cleanup:organizations": "tsx scripts/cleanup-organizations.ts",
    "db:assign-owner": "tsx scripts/assign-organization-owner.ts",
    "db:migrate:project-ownership": "tsx scripts/migrate-project-ownership.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "work-orders:run": "tsx --env-file=.env scripts/run-work-orders.ts",
    "types:gen": "bos types gen && tsx scripts/ensure-auth-types.ts",
    "postinstall": "pnpm run types:gen || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "echo 'Packages versioned - app release handled by workflow'",
    "test": "pnpm run types:gen && pnpm --dir api --if-present run test && pnpm --dir ui --if-present run test && for d in plugins/*; do if [ -f \"$d/package.json\" ]; then pnpm --dir \"$d\" --if-present run test || exit 1; fi; done",
    "test:api": "pnpm --dir api test",
    "test:integration": "pnpm --dir api test tests/integration/",
    "test:ui": "cd ui && pnpm run test",
    "dev:postgres": "docker compose up -d --wait && pnpm run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait",
    "bos": "bos",
    "db:doctor": "bos db:doctor",
    "db:repair": "bos db:repair"
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "latest",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "@changesets/cli": "^2.29.8",
    "@types/pg": "catalog:",
    "@playwright/test": "^1.58.1"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@hot-labs/near-connect": "0.11.2",
    "@libsql/client": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:",
    "mermaid": "^11.16.0",
    "zod": "catalog:",
    "pg": "catalog:"
  },
  "engines": {
    "node": ">=20.11"
  }
}
