GOOGLE_STARTER_TEMPLATE_ID=
GOOGLE_TOKENS_SECRET_KEY=
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=
# Optional: Documenso e-signature. When set, "Offer to builder" sends the work order to Documenso,
# which emails the builder, then the representative, a signing request.
