    {
      "id": "7f78fb3c-8cd5-4b86-b3f0-68b552a4c15d",
      "name": "Emails from MultiAgency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "jsCode": "// MultiAgency writes every email; this only hands them to Gmail.\n// Input: the verified webhook item ($json.body is the work order event).\nconst out = [];\nfor (const item of $input.all()) {\n  const e = item.json.body;\n  for (const m of e.emails || []) {\n    if (m && m.to) out.push({ json: { to: m.to, subject: m.subject, text: m.text, eventId: e.id, type: e.type } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "b01628c7-e8df-4e06-86f0-ecdc92f6794a",
      "name": "Send email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "03d957f6-2de1-4b78-960e-dd2ddf965d0d",
      "name": "Work order created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "44f924c9-b929-4cd2-b8bd-aa125faaba97",
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "work_order.created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "03b3585d-54ed-4ed3-811e-a155dc124eb5",
      "name": "Prepare document fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "// Values for every {{placeholder}} in the work order template.\nconst e = $input.first().json.body;\nconst t = e.terms || {};\nconst long = (d) => d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '';\nconst box = (on) => (on ? '☑' : '☐');\nconst ip = (t.ipModel || '').toLowerCase();\nconst known = ['assignment', 'license', 'open_source'];\nreturn [{ json: { fields: {\n  work_order_id: e.workOrder.id,\n  effective_date: long(t.effectiveDate || e.workOrder.periodStart),\n  contractor_name: e.contractor.name,\n  project: e.workOrder.project,\n  services_agreement_date: t.servicesAgreementDate ? long(t.servicesAgreementDate) : '',\n  representative_name: e.representative.name,\n  budget_usd: t.budgetUsd || '',\n  period_start: long(e.workOrder.periodStart),\n  period_end: long(e.workOrder.periodEnd),\n  ip_assignment: box(ip === 'assignment'),\n  ip_license: box(ip === 'license'),\n  ip_open_source: box(ip === 'open_source'),\n  ip_other: box(ip !== '' && !known.includes(ip)),\n  ip_other_text: ip !== '' && !known.includes(ip) ? t.ipModel : '',\n  payee_account: t.payee || '',\n  payout_method: t.payoutMethod === 'withdraw' ? 'Withdrawal to the NEAR wallet' : 'Transfer to the NEAR Intents balance',\n  contractor_github: t.contractorGithub || '',\n  repos: (t.repos || []).join(', '),\n  auto_renew: box(t.autoRenew === true),\n  auto_renew_text: t.autoRenew === true ? 'This work order renews monthly, with the same terms, while the base metrics are met; otherwise the representative decides whether it renews.' : '',\n  contractor_email: e.contractor.email || '',\n  representative_email: e.representative.email || '',\n} } }];"
      }
    },
