      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "4b309d6d-2ab9-45a6-97d2-1b7ddab82464",
              "leftValue": "={{ $json.headers['x-ap-signature'] }}",
              "rightValue": "={{ 'sha256=' + $json.computedSignature }}",
